{
  "name": "a4d-watcher",
  "displayName": "ai4dev Tunnel",
  "description": "Monitor and control the ai4dev tunnel from VS Code.",
  "version": "0.1.2",
  "publisher": "nitronicolasoft",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:ai4devTunnel.showActions"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ai4devTunnel.showActions",
        "title": "ai4dev Tunnel",
        "category": "ai4dev Tunnel"
      }
    ],
    "configuration": {
      "title": "ai4dev Tunnel",
      "properties": {
        "ai4devTunnel.installPath": {
          "type": "string",
          "default": "~/agents/ai4dev/ai4dev_tunnel"
        },
        "ai4devTunnel.authenticationPromptPrefill": {
          "type": "boolean",
          "default": true,
          "description": "Whether to enable authentication-renewal command prefill in the next interactive shell prompt."
        },
        "ai4devTunnel.wslDistro": {
          "type": "string",
          "default": ""
        },
        "ai4devTunnel.refreshIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1
        },
        "ai4devTunnel.commandTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 1
        },
        "ai4devTunnel.logLines": {
          "type": "number",
          "default": 50,
          "minimum": 1
        }
      }
    }
  },
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/NicolasWeb/ai-agents-md.git",
    "directory": "vs-code-extensions/home-made/a4d-watcher"
  },
  "bugs": {
    "url": "https://github.com/NicolasWeb/ai-agents-md/issues"
  },
  "homepage": "https://github.com/NicolasWeb/ai-agents-md/tree/main/vs-code-extensions/home-made/a4d-watcher",
  "keywords": [
    "ai4dev",
    "tunnel",
    "vscode",
    "wsl",
    "status-bar",
    "remote-development"
  ]
}
